# ZORY backend configuration. Copy to .env and adjust.
# Every value here overrides the matching default in app/config.py (pydantic-settings).

# --- OpenAI (optional - the app runs fully without a key: guide copy falls back to
# --- built-in templates and the AI photo preview shows a clear disabled state) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
# Reasoning effort for GPT-5.5 copy calls: none | low | medium | high | xhigh
REASONING_EFFORT=low
# Seconds before LLM copy calls fall back to templates
LLM_TIMEOUT_S=8
# Seconds allowed for a gpt-image-2 render
RENDER_TIMEOUT_S=90
# Default render size (WxH, each snapped to /16, 256-2048, aspect within 1:3..3:1)
RENDER_DEFAULT_SIZE=1280x896
# How many product photos are attached as references alongside the floor plan
RENDER_MAX_REF_IMAGES=3

# --- HTTP -------------------------------------------------------------------
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Storage & data ----------------------------------------------------------
# Paths are relative to the backend directory unless absolute
DB_PATH=var/zory.db
STATIC_DIR=static
CATALOG_PATH=app/data/catalog.json

# --- Scene geometry (shared by the 2D canvas and the 3D view) --------------------
WALL_THICKNESS_CM=12

# --- Money ----------------------------------------------------------------------
# Catalog amounts are stored in BASE_CURRENCY; displays convert via CURRENCY_RATES
# (units of that currency per 1 unit of base). Only currencies listed in
# SUPPORTED_CURRENCIES are accepted anywhere in the API.
SUPPORTED_CURRENCIES=["USD","SAR"]
BASE_CURRENCY=USD
DEFAULT_CURRENCY=SAR
# SAR is pegged to the USD at 3.75
CURRENCY_RATES={"USD":1.0,"SAR":3.75}

# --- Caches & limits ----------------------------------------------------------
ANALYSIS_CACHE_SIZE=256
COPY_CACHE_SIZE=512
# Max accepted canvas snapshot size for /render (bytes)
MAX_RENDER_PNG_BYTES=4194304

DEBUG=false
